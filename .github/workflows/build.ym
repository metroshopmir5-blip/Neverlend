name: Neverlend iOS Build

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Select Xcode
        run: xcode-select -p

      - name: Check project files
        run: |
          echo "Checking Neverlend source..."
          find . -maxdepth 4 -type f

